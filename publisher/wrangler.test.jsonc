{
  // Test build: the real Ledger ships in the same script, so the tests drive a real ledger
  // and read the R2 log it writes. `TestPublisher` is `Publisher` plus test seams.
  "name": "viz-publisher-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "PUBLISHER", "class_name": "TestPublisher" },
      { "name": "LEDGER", "class_name": "Ledger" },
      // The frozen as-built ledger (ledger/bench/asbuilt/): an independent writer of the
      // first log layout (base.json + one object per change), which the publisher still reads.
      { "name": "LEDGER_ASBUILT", "class_name": "LedgerAsBuilt" },
      // The release of the ledger before checkpoints in parts (ledger/bench/before/, frozen): it
      // writes format-1 checkpoints only. The publisher must read its log as well (ledger N-1).
      { "name": "LEDGER_BEFORE", "class_name": "LedgerBefore" },
      // The publisher release before it read the span and log tables (test/n1/, frozen at 9292abb):
      // release N-1 beside this one, for the rollout rule of design/DECISIONS.md D64.
      { "name": "PUBLISHER_N1", "class_name": "TestPublisherN1" },
      // The D64 release (test/d64/, frozen at bcfe8db): reads the span and log tables and does not
      // publish them. Release N-1 of this one, which publishes them (design/DECISIONS.md D65).
      { "name": "PUBLISHER_D64", "class_name": "TestPublisherD64" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestPublisher", "Ledger", "LedgerAsBuilt"] }, { "tag": "v2", "new_sqlite_classes": ["LedgerBefore"] }, { "tag": "v3", "new_sqlite_classes": ["TestPublisherN1"] }, { "tag": "v4", "new_sqlite_classes": ["TestPublisherD64"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "viz-lake" }],
  "vars": { "CELL": "cell-0", "ICEBERG_LOCATION_PREFIX": "s3://viz-lake" }
}
