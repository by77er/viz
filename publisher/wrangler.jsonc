{
  "name": "viz-publisher",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "PUBLISHER", "class_name": "Publisher" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Publisher"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "viz-lake" }],
  "vars": {
    // URI of the bucket root as external engines address it. Written into Iceberg metadata.
    "ICEBERG_LOCATION_PREFIX": "s3://viz-lake"
  }
}
