{
  "name": "@viz/ruler",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutants": "node scripts/mutants.mjs",
    "bench": "vitest run test/bench.test.ts --reporter=verbose",
    "bench:anomaly": "vitest run --config vitest.measure.config.ts --maxWorkers=1 --reporter=verbose",
    "independent": "vitest run test/independent.test.ts && cd tools/promcheck && VIZ_CAPTURE=../../.capture go test -count=1 -v ./..."
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261117.1",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0",
    "yaml": "^2.9.1"
  }
}
