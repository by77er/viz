{
  "name": "viz-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "viz-lake" }],
  "vars": { "CELL": "cell-0" }
}
