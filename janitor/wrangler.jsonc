{
  "name": "viz-janitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // As in flush/: the shard and ledger classes ship in this script so the tests run against
  // the real Durable Objects. In production these are bindings to the scripts that own them.
  "durable_objects": {
    "bindings": [
      { "name": "SHARD", "class_name": "Shard" },
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shard", "Ledger"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "viz-lake" }],
  // Retention policies (`retention:<tenant>`).
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
  "vars": { "CELL": "cell-0" }
}
