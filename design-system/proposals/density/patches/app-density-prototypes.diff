diff --git a/app/src/shell/Popover.tsx b/app/src/shell/Popover.tsx
new file mode 100644
index 0000000..6c4fbf8
--- /dev/null
+++ b/app/src/shell/Popover.tsx
@@ -0,0 +1,77 @@
+import { useCallback, useEffect, useId, useRef, useState, type ReactNode } from 'react'
+
+interface Props {
+  /** The words of the button that opens it; it ends in "…" (it opens something). */
+  label: ReactNode
+  /** The button's accessible name, when its words alone do not say what it is for. */
+  name?: string
+  /** 'menu': rows of commands (role menu, arrow keys); 'dialog': controls and fields (a non-modal dialog, Tab moves through it). */
+  kind: 'menu' | 'dialog'
+  /** The popover's accessible name. */
+  title: string
+  quiet?: boolean
+  small?: boolean
+  testId?: string
+  align?: 'start' | 'end'
+  children: (close: () => void) => ReactNode
+}
+
+/**
+ * A button and what it opens, on the design system's Menu (vz-menu-anchor, vz-menu): under the button, left edges aligned
+ * (right edges with align="end"); with a coarse pointer below 640 px, a sheet across the bottom of the screen. It closes on
+ * Escape, on a press outside and on choosing a command; focus returns to the button.
+ */
+export function Popover({ label, name, kind, title, quiet, small, testId, align = 'start', children }: Props) {
+  const [open, setOpen] = useState(false)
+  const id = useId()
+  const button = useRef<HTMLButtonElement>(null)
+  const box = useRef<HTMLDivElement>(null)
+  const close = useCallback((refocus = true) => {
+    setOpen(false)
+    if (refocus) button.current?.focus()
+  }, [])
+  useEffect(() => {
+    if (!open) return
+    const first = box.current?.querySelector<HTMLElement>(kind === 'menu' ? '[role^=menuitem]' : '[aria-pressed=true], button, input, select, a[href]')
+    first?.focus()
+    const onDown = (e: PointerEvent) => {
+      const t = e.target as Node
+      if (!box.current?.contains(t) && !button.current?.contains(t)) close(false)
+    }
+    document.addEventListener('pointerdown', onDown, true)
+    return () => document.removeEventListener('pointerdown', onDown, true)
+  }, [open, kind, close])
+  const onKey = (e: React.KeyboardEvent) => {
+    if (e.key === 'Escape') {
+      e.stopPropagation()
+      close()
+      return
+    }
+    if (kind !== 'menu' || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) return
+    const rows = [...(box.current?.querySelectorAll<HTMLElement>('[role^=menuitem]') ?? [])]
+    const at = rows.indexOf(document.activeElement as HTMLElement)
+    rows[(at + (e.key === 'ArrowDown' ? 1 : rows.length - 1)) % rows.length]?.focus()
+    e.preventDefault()
+  }
+  return (
+    <div className="vz-menu-anchor" onKeyDown={onKey}>
+      <button
+        ref={button}
+        className="vz-button"
+        data-size={small ? 'sm' : undefined}
+        data-quiet={quiet ? '' : undefined}
+        aria-haspopup={kind}
+        aria-expanded={open}
+        aria-controls={id}
+        aria-label={name}
+        onClick={() => setOpen((v) => !v)}
+        data-testid={testId}
+      >
+        {label}
+      </button>
+      <div ref={box} id={id} className={kind === 'dialog' ? 'vz-menu vz-popover' : 'vz-menu'} role={kind} aria-label={title} data-open={open ? '' : undefined} data-align={align === 'end' ? 'end' : undefined}>
+        {open && children(() => close())}
+      </div>
+    </div>
+  )
+}
