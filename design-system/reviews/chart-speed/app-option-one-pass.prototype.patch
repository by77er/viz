+/**
+ * PROTOTYPE (design-system/reviews/chart-speed, option 1): the chart's arrays straight from the
+ * result as it was read, in one pass, for the usual case in which every sample is on the grid
+ * (the same test and the same order as `alignSeries`, then `toSpec`). Null when a sample is off
+ * the grid or the unit is scaled by the largest value: the caller then takes the two-pass way.
+ */
+export function specOfMatrix(result: readonly SampleColumns[], start: number, end: number, step: number, unit: UnitId, query: string, shiftMs: number): { spec: ChartSpec; unit: ChartUnit } | null {
+  if (unit === 'bytes/s') return null
+  const u = chartUnit(unit, 0)
+  const tolerance = 5e-6 / step
+  const n = Math.floor((end - start) / step + Math.max(1e-9, tolerance)) + 1
+  if (!(n > 0 && n <= 1_000_000)) return null
+  const scale = u.scale
+  const made: { name: string; at: number; s: SpecSeries }[] = []
+  for (let s = 0; s < result.length; s++) {
+    const r = result[s]!
+    const times = r.times
+    const vs = r.values
+    const len = times.length
+    const values = new Array<number | null>(n)
+    for (let k = 0; k < len; k++) {
+      const pos = (times[k]! - start) / step
+      const i = Math.round(pos)
+      if (i < 0 || i >= n || Math.abs(pos - i) > tolerance) return null
+      const v = vs[k]!
+      values[i] = v - v === 0 ? v * scale : null
+    }
+    // A step with no sample is a gap.
+    if (len !== n) for (let i = 0; i < n; i++) if (values[i] === undefined) values[i] = null
+    made.push({ name: seriesName(r.metric), at: s, s: { labels: chartLabels(r.metric, query), values } })
+  }
+  made.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : a.at - b.at))
+  return { spec: { unit: u.name, agg: NO_AGGREGATE, t0: Math.round(start * 1000) + shiftMs, step: Math.round(step * 1000), series: made.map((m) => m.s) }, unit: u }
+}
