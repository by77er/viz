@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest'
+import { alignSeries } from '../lib/series'
+import { specOfMatrix, toSpec } from './spec'
+
+const lcg = (seed: number) => { let s = seed >>> 0; return () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296 }
+
+describe('specOfMatrix (prototype)', () => {
+  it('gives what alignSeries then toSpec give, or declines', () => {
+    const r = lcg(42)
+    let direct = 0
+    for (let c = 0; c < 400; c++) {
+      const step = [15, 30, 60, 0.5, 0.001][Math.floor(r() * 5)]!, n = 1 + Math.floor(r() * 60), start = 1795000000 + Math.floor(r() * 1000) * step, end = start + (n - 1) * step
+      const offGrid = r() < 0.1
+      const series = Array.from({ length: 1 + Math.floor(r() * 12) }, (_, i) => {
+        const times: number[] = [], values: number[] = []
+        for (let k = 0; k < n; k++) { if (r() < 0.15) continue; times.push(start + k * step + (offGrid && r() < 0.2 ? step / 3 : 0)); values.push(r() < 0.05 ? NaN : r() < 0.03 ? Infinity : (r() - 0.3) * 100) }
+        const metric: Record<string, string> = r() < 0.1 ? {} : { __name__: 'm', pod: 'p' + Math.floor(r() * 6), i: String(i % 3) }
+        return { metric, times: Float64Array.from(times), values: Float64Array.from(values) }
+      })
+      const unit = (['none', 'seconds', 'percentunit', 'bytes', 'bytes/s'] as const)[Math.floor(r() * 5)]!
+      const old = toSpec({ data: alignSeries(series, start, end, step), start, step, unit, query: 'q', shiftMs: 3600000 })
+      const got = specOfMatrix(series, start, end, step, unit, 'q', 3600000)
+      if (got === null) continue
+      direct++
+      expect(got).toEqual(old)
+    }
+    expect(direct).toBeGreaterThan(200)
+  })
+})
