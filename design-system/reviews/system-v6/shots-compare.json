   "steps": [
    {
     "eval": "const el = document.querySelector('[data-view=\"demo-bytes\"]'); const n = 61, t0 = Date.UTC(2026, 10, 18, 9, 16), w = (i) => 2 * Math.PI * i / 36; el.vz.setData({ unit: 'req/s', agg: 'mean', t0, step: 360000, series: [{ labels: { service: 'checkout-api' }, values: Array.from({ length: n }, (_, i) => +(120 * Math.sin(w(i))).toFixed(2)) }, { labels: { service: 'cart' }, values: Array.from({ length: n }, (_, i) => +(60 * Math.cos(w(i))).toFixed(2)) }] })"
