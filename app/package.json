{
  "name": "@viz/app",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "tsx mock/server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/app.cjs && node e2e/errors.cjs && node e2e/prod.cjs",
    "e2e:real": "node e2e/real.cjs",
    "contract": "node e2e/contract.cjs",
    "real": "node real/stack.mjs",
    "design-system": "node ../design-system/tools/build.mjs",
    "predev": "node scripts/ensure-design-system.mjs",
    "prebuild": "node scripts/ensure-design-system.mjs",
    "measure": "node e2e/measure.cjs",
    "check:tokens": "node ../design-system/tools/check.mjs --no-render src index.html"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@prometheus-io/codemirror-promql": "^0.316.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
