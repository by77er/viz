    "check:quick": "quint typecheck viz.qnt && node experiments.mjs teeth literal witness",
    "check:teeth": "node experiments.mjs teeth",
    "check:literal": "node experiments.mjs literal",
    "check:witness": "node experiments.mjs witness",
    "check:fixed": "node experiments.mjs fixed",
    "check:sim": "node experiments.mjs sim"
  },
  "dependencies": {
    "@informalsystems/quint": "0.33.1"
  }
}
