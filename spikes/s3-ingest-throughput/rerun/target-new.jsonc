{
  // Spike S3 re-run target (see ../README.md). Deployed only for the measurement, then deleted.
  "name": "viz-spike-s3-new",
  "main": "target-new.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SHARD", "class_name": "Shard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shard"] }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "KV_ID" }],
  "vars": { "DEFAULT_POOL": "{\"pool\":\"s3-default-new\",\"slots\":1,\"spread\":1,\"epoch\":1}" }
}
